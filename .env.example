# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://quisqueya-domino.onrender.com).
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string provided automatically by Render Postgres
DATABASE_URL="postgresql://user:password@host:5432/quisqueya_domino"

# AUTH_SESSION_SECRET: Secret key used to sign session tokens (auto-generated fallback in dev)
AUTH_SESSION_SECRET="change-me-in-production-32-chars"

# TX_ENCRYPTION_KEY: 32-byte hex or passphrase for AES-256-GCM financial transaction encryption
TX_ENCRYPTION_KEY="change-me-tx-aes256-gcm-secret-key"

# Optional Live Payment Gateway Keys (Stripe / PayPal / Azul RD)
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
